# Credentials: ANTHROPIC_API_KEY, or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Bullpen models (defaults shown)
DIRECTOR_MODEL=claude-opus-5-5
DIRECTOR_EFFORT=medium
CONTINUITY_MODEL=claude-haiku-5-5
# rules = engine checks only; llm = engine checks + Continuity Editor model pass
CONTINUITY=rules

# Set MOCK=1 to run the scripted Director with no API calls
MOCK=
# Generate the next chunk when the theater has less than this much queued (ms)
LEAD_MS=25000
# World RNG seed; same seed + same beats = same fight outcomes
SEED=616
PORT=8787
# Hosted deployments: require this password (browser prompts for it; any user name)
AUTH_PASSWORD=
