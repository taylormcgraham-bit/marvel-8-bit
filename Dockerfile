FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY canon ./canon
COPY inbox ./inbox
VOLUME ["/app/data"]
EXPOSE 8787
CMD ["node", "dist/server/src/index.js"]
